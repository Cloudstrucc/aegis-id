# App Store Connect API credentials for scripts/release-ios.sh.
#
# Copy this file to .env.ios (untracked) and fill in your own values:
#     cp .env.ios.example .env.ios
#
# These are per Apple *team*, not per environment — dev, qa and prod all sign
# for the same team and upload to the same App Store Connect account, so one
# set of values covers every build.
#
# Where to find them: appstoreconnect.apple.com -> Users and Access ->
# Integrations -> App Store Connect API -> Team Keys.

# The 10-character Key ID shown in the key's row.
ASC_KEY_ID=

# The team's Issuer ID, a UUID shown above the key list. It never changes.
ASC_ISSUER_ID=

# The private key itself is NOT stored here. Apple lets you download the .p8
# exactly once; put it at the path altool expects, named after the Key ID:
#
#     mkdir -p ~/.appstoreconnect/private_keys
#     mv ~/Downloads/AuthKey_<KEY_ID>.p8 ~/.appstoreconnect/private_keys/
#
# Keep it out of the repository — it can upload builds as you.
