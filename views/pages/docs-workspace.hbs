<section class="docs-workspace-page">
  <section class="docs-shell" aria-label="Aegis ID documentation">
    <aside class="docs-sidebar">
      <div class="docs-sidebar__header">
        <p class="eyebrow">Documentation</p>
        <h1>Docs</h1>
        <p>{{documentCount}} technical guides organized by implementation area.</p>
      </div>

      <form class="docs-search" method="get" action="/developer/docs">
        <label for="docs-search-query">Search docs</label>
        <div>
          <input id="docs-search-query" name="q" type="search" value="{{query}}" placeholder="Search OIDC, RBAC, passkeys">
          <button type="submit">Search</button>
        </div>
      </form>

      {{!--
        Release notes are pinned above the category list with a rule under
        them, not filed inside it. They are not a guide to anything — they are
        the record of what this deployment is running — and a reader looking
        for them should not have to guess which of seven categories somebody
        decided they belonged to.
      --}}
      <nav class="docs-pinned" aria-label="Release notes">
        <a class="docs-pinned__link {{#if isReleases}}is-active{{/if}}" href="/developer/docs/releases">
          <span class="docs-pinned__icon" aria-hidden="true">{{agIcon "tag" 16}}</span>
          <span class="docs-pinned__label">Release notes</span>
          {{#if releaseVersionBadge}}<span class="docs-pinned__badge">{{releaseVersionBadge}}</span>{{/if}}
        </a>
        <a class="docs-pinned__link {{#if isLanding}}is-active{{/if}}" href="/developer/docs">
          <span class="docs-pinned__icon" aria-hidden="true">{{agIcon "grid" 16}}</span>
          <span class="docs-pinned__label">Overview</span>
        </a>
      </nav>

      {{#if hasQuery}}
        <section class="docs-search-results" aria-label="Search results">
          <div class="docs-nav-heading">Results</div>
          {{#if hasSearchResults}}
            {{#each searchResults}}
              <a class="docs-result-link" href="{{href}}">
                <strong>{{title}}</strong>
                <span>{{categoryTitle}}</span>
              </a>
            {{/each}}
          {{else}}
            <p>No docs matched “{{query}}”.</p>
          {{/if}}
        </section>
      {{/if}}

      <nav class="docs-nav" aria-label="Documentation categories">
        {{#each categories}}
          <details class="docs-category" {{#if isActive}}open{{/if}}>
            <summary>
              <span>{{title}}</span>
              <small>{{count}}</small>
            </summary>
            <div class="docs-category__links">
              {{#each documents}}
                <a href="{{href}}" class="{{#if isActive}}is-active{{/if}}">{{title}}</a>
              {{/each}}
            </div>
          </details>
        {{/each}}
      </nav>
    </aside>

    <article class="docs-reader">
      {{!--
        One header bar for every view in this panel, not one per partial.
        It is the same object as the sidebar's header in the other column, so
        it carries the same rule and the same vertical rhythm — drawn
        separately they sat at different heights across the page.
      --}}
      {{#if isReleases}}
        <div class="docs-reader__meta">
          <span>Release notes</span>
          <a href="{{releases.repoUrl}}" target="_blank" rel="noopener">All releases ↗</a>
        </div>
        {{> docs-releases releases=releases}}
      {{else if isLanding}}
        <div class="docs-reader__meta">
          <span>Overview</span>
          <a href="/developer/openapi.json" target="_blank" rel="noopener">OpenAPI JSON</a>
        </div>
        {{> docs-landing}}
      {{else if selected}}
        <div class="docs-reader__meta">
          <span>{{selected.categoryTitle}}</span>
          <a href="/developer/openapi.json" target="_blank" rel="noopener">OpenAPI JSON</a>
        </div>
        <div class="docs-reader__content">
          {{{selected.html}}}
        </div>
      {{else}}
        <div class="docs-empty-state">
          <h2>No documentation found.</h2>
          <p>Add Markdown files under <code>docs/content</code> and refresh this page.</p>
        </div>
      {{/if}}
    </article>
  </section>
</section>
