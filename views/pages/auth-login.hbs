<section class="page-hero page-hero--compact">
  <p class="eyebrow">Subscriber access</p>
  <h1>Sign in to {{site.branding.shortName}}.</h1>
  <p>Use your subscriber account before opening organization dashboards, setup wizards, or wallet challenge demos.</p>
</section>

<section class="band band--white">
  <div class="auth-grid auth-grid--split">
    <div class="auth-panel">
      <form class="auth-panel__form" action="/auth/login" method="post" novalidate>
        {{#if errorMessage}}<p class="form-alert">{{errorMessage}}</p>{{/if}}
        <div class="field-group">
          <label for="email">Work email</label>
          <input id="email" name="email" type="email" value="{{formValues.email}}" autocomplete="email" required>
        </div>
        <div class="field-group">
          <label for="password">Password</label>
          <input id="password" name="password" type="password" autocomplete="current-password" required>
        </div>

        <button class="button button--primary" type="submit">Continue</button>

        <div class="auth-panel__links">
          <p class="form-footnote"><a href="/auth/forgot">Forgot your password?</a></p>
          <p class="form-footnote">Need access? <a href="/auth/register">Create an account</a></p>
        </div>
      </form>

      {{#if (or passkeyLoginEnabled walletLoginEnabled)}}
        <div class="auth-panel__alternatives">
          <p class="auth-divider">or</p>

          {{#if walletLoginEnabled}}
            <a class="button button--ghost" href="/auth/login/wallet">
              <svg class="auth-panel__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                   stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="5" y="2" width="14" height="20" rx="2"></rect>
                <path d="M12 18h.01"></path>
              </svg>
              Sign in with your wallet
            </a>
            <p class="auth-hint">Scan a code and approve from the Aegis wallet on your phone. No password.</p>
          {{/if}}

          {{#if passkeyLoginEnabled}}
          <button class="button button--ghost" type="button" data-passkey-login>
            <svg class="auth-panel__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="11" width="18" height="10" rx="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            Sign in with a passkey
          </button>

          <p class="form-footnote form-footnote--centred" data-passkey-status aria-live="polite"></p>
          <p class="auth-hint">Uses Face ID, Touch ID, Windows Hello or a security key. No password needed.</p>
          {{/if}}
          <p class="auth-hint">Lost your device? <a href="/auth/recover">Use a recovery code</a>, or <a href="/auth/recover/approvals">ask your root wallets to approve</a>.</p>
        </div>
      {{/if}}
    </div>

    <aside class="auth-aside" aria-labelledby="auth-aside-title">
      <h2 class="auth-aside__title" id="auth-aside-title">Why signing in asks for more than a password.</h2>

      <ul class="auth-aside__list">
        <li>
          <span class="auth-aside__icon">{{agIcon "shield" 18}}</span>
          <div>
            <h3>Two kinds of proof, not two passwords</h3>
            <p>A password is something you know, so on its own it never finishes a sign-in.{{#if passkeyLoginEnabled}} A passkey is something you have and something you are at once, so it can.{{/if}}</p>
          </div>
        </li>

        {{#if walletLoginEnabled}}
          <li>
            <span class="auth-aside__icon">{{agIcon "chain" 18}}</span>
            <div>
              <h3>A wallet approval is evidence</h3>
              <p>Approving and declining are both real answers, and both are written to an immutable ledger with the wallet that gave them.</p>
            </div>
          </li>
        {{/if}}

        <li>
          <span class="auth-aside__icon">{{agIcon "lifebuoy" 18}}</span>
          <div>
            <h3>Losing the device is not losing the account</h3>
            <p>Recover with a code sent to your registered address, or have two of your organization&rsquo;s root wallets approve. No administrator ever sees a credential of yours.</p>
          </div>
        </li>
      </ul>

      <p class="auth-aside__foot">
        New to {{site.branding.shortName}}? <a href="/plans">Compare the plans</a> &mdash; the trial needs no card.
      </p>
    </aside>
  </div>
</section>
