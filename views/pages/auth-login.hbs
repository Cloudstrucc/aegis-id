<section class="page-hero page-hero--compact">
  <p class="eyebrow">Subscriber access</p>
  <h1>Sign in to Aegis ID.</h1>
  <p>Use your subscriber account before opening organization dashboards, setup wizards, or wallet challenge demos.</p>
</section>

<section class="band band--white">
  <div class="auth-grid auth-grid--compact">
    <div class="section-heading">
      <p class="eyebrow">Passport.js</p>
      {{#if passkeyLoginEnabled}}
        <h2>Choose how you sign in.</h2>
        <p>Organization subscription and administration require a verified session — a password plus a second factor, or a passkey on its own.</p>
      {{else}}
        <h2>Password first, second factor next.</h2>
        <p>Organization subscription and administration require an authenticated user session plus email, SMS, or passkey verification.</p>
      {{/if}}
    </div>

    <div class="auth-panel">
      <form class="auth-panel__form" action="/auth/login" method="post" novalidate>
        {{#if errorMessage}}<p class="form-alert">{{errorMessage}}</p>{{/if}}
        <div class="field-group">
          <label for="email">Work email</label>
          <input id="email" name="email" type="email" value="{{formValues.email}}" autocomplete="email" required>
        </div>
        <div class="field-group">
          <label for="password">Password</label>
          <input id="password" name="password" type="password" autocomplete="current-password" required>
        </div>

        <button class="button button--primary" type="submit">Continue</button>

        <div class="auth-panel__links">
          <p class="form-footnote"><a href="/auth/forgot">Forgot your password?</a></p>
          <p class="form-footnote">Need access? <a href="/auth/register">Create an account</a></p>
        </div>
      </form>

      {{#if passkeyLoginEnabled}}
        <div class="auth-panel__alternatives">
          <p class="auth-divider">or</p>

          <button class="button button--ghost" type="button" data-passkey-login>
            <svg class="auth-panel__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="11" width="18" height="10" rx="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            Sign in with a passkey
          </button>

          <p class="form-footnote form-footnote--centred" data-passkey-status aria-live="polite"></p>
          <p class="auth-hint">Uses Face ID, Touch ID, Windows Hello or a security key. No password needed.</p>
          <p class="auth-hint">Lost your device? <a href="/auth/recover">Use a recovery code</a>.</p>
        </div>
      {{/if}}
    </div>
  </div>
</section>
