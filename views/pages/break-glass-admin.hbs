<section class="page-hero page-hero--compact">
  <p class="eyebrow">Platform settings</p>
  <h1>Break-glass recovery.</h1>
  <p>For an organization that has lost every root wallet. This is the only route from here into a customer's organization, and it cannot be walked alone.</p>
</section>

<section class="band band--white">
  {{#if redeemed}}
    <div class="callout callout--success">
      <strong>Break-glass code accepted for {{redeemed}}.</strong>
      <span>Recorded on the evidence chain with the ticket reference and the root wallet whose authorisation this acted on.</span>
    </div>
  {{/if}}
  {{#if errorMessage}}
    <div class="callout callout--warning"><strong>Not accepted.</strong> <span>{{errorMessage}}</span></div>
  {{/if}}

  <article class="callout callout--warning">
    <strong>You cannot do this on your own, by design</strong>
    <span>
      A break-glass code is generated by the customer and never stored here — we
      keep only a hash. It does nothing until one of their root wallets
      authorises it, which they do while their wallets still exist. So this
      screen needs two things neither of which is ours: their code, and their
      root wallet's prior permission. An attempt with an unauthorised code is
      refused and recorded.
    </span>
  </article>

  <form class="subscribe-form subscribe-form--narrow" action="/admin/break-glass" method="post">
    <div class="field-group">
      <label for="code">Break-glass code</label>
      <input id="code" name="code" type="text" placeholder="XXXXX-XXXXX-XXXXX-XXXXX" autocomplete="off" spellcheck="false" required>
      <p class="table-note">As sent to you by the customer. Never ask for it over an unverified channel.</p>
    </div>
    <div class="field-group">
      <label for="ticketReference">Support ticket</label>
      <input id="ticketReference" name="ticketReference" type="text" maxlength="120" placeholder="e.g. TICKET-4821" required>
      <p class="table-note">Required. The out-of-band conversation belongs on the record too.</p>
    </div>
    <div class="inline-actions">
      <button class="button button--primary button--blue" type="submit">Redeem code</button>
      <a class="button button--ghost" href="/admin">All settings</a>
    </div>
  </form>

  <h2>Previously redeemed</h2>
  {{#if history.length}}
    <table class="data-table">
      <thead><tr><th>Organization</th><th>Code</th><th>Redeemed</th><th>Ticket</th><th>On whose authority</th></tr></thead>
      <tbody>
        {{#each history}}
          <tr>
            <td>{{this.organization}}</td>
            <td><code>{{this.hint}}-·····</code></td>
            <td>{{this.redeemedAt}}<div class="table-note">by {{this.redeemedBy}}</div></td>
            <td>{{this.ticketReference}}</td>
            <td><code>{{this.authorisedByWalletId}}</code><div class="table-note">authorised {{this.authorisedAt}}</div></td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  {{else}}
    <p class="muted">No break-glass code has ever been redeemed on this deployment.</p>
  {{/if}}
</section>
