<section class="page-hero page-hero--compact">
  <p class="eyebrow">Account recovery</p>
  <h1>Reset your password.</h1>
  <p>We will email a single-use link to the address on your account.</p>
</section>

<section class="band band--white">
  <div class="auth-grid auth-grid--compact">
    {{#if sent}}
      <div class="section-heading">
        <h2>Check your inbox.</h2>
        <p>
          If that address has an Aegis ID account, a reset link is on its way. It
          expires in {{expiresInMinutes}} minutes and can only be used once.
        </p>
        <p class="form-footnote">
          Nothing arrived? Check your spam folder, then
          <a href="/auth/forgot">try again</a>.
        </p>
      </div>
    {{else}}
      <div class="section-heading">
        <p class="eyebrow">Step 1 of 2</p>
        <h2>Where should we send the link?</h2>
        <p>Enter the work email you sign in with.</p>
      </div>

      <form class="subscribe-form" action="/auth/forgot" method="post" novalidate>
        <div class="field-group">
          <label for="email">Work email</label>
          <input id="email" name="email" type="email" value="{{formValues.email}}" autocomplete="email" required>
        </div>
        <button class="button button--primary" type="submit">Send reset link</button>
        <p class="form-footnote">Remembered it? <a href="/auth/login">Back to sign in</a>.</p>
      </form>
    {{/if}}
  </div>
</section>
