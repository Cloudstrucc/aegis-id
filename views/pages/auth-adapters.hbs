{{!--
  Serves two surfaces: the platform view at /admin/auth-adapters, which sees
  every adapter on the deployment, and the organization view at
  /orgs/:handle/settings/adapters, which sees only that organization's. The
  difference between them is `basePath` and `canSetSignInDefault` — the markup
  is shared so the two cannot drift apart.
--}}
<section class="band band--white surface-app">
  <div class="aeg-page">
    {{#if tenant}}
      <nav class="aeg-crumb" aria-label="Breadcrumb">
        <a href="{{tenant.publicPath}}">{{tenant.organization}}</a> ›
        <a href="{{settingsPath}}">Settings</a> › Authentication adapters
      </nav>
    {{/if}}

    <div class="aeg-page-head">
      <p class="aeg-eyebrow">{{#if scopeLabel}}{{scopeLabel}}{{else}}Platform settings{{/if}}</p>
      <h1>Authentication adapters</h1>
      <p>
        Connect an external identity protocol so it can front connected-app
        sign-in. SAML 2.0, Kerberos/SPNEGO and certificate-based auth (CBA) are
        the out-of-the-box protocols; provider presets build on them. Aegis
        stays the policy decision point for every route.
      </p>
    </div>

    {{#unless enabled}}
      <div class="aeg-callout aeg-callout--warn">
        <span class="aeg-callout__icon" aria-hidden="true">⚠</span>
        <div class="aeg-callout__body">
          <p class="aeg-callout__title">Framework disabled in this environment</p>
          <p>Adapters can be configured and tested, but will not front sign-in until <code>ADAPTER_FRAMEWORK_ENABLED</code> is on.</p>
        </div>
      </div>
    {{/unless}}

    {{#if saved}}
      <div class="aeg-callout aeg-callout--ok">
        <span class="aeg-callout__icon" aria-hidden="true">✓</span>
        <div class="aeg-callout__body">
          <p>
            {{#if (eq saved "created")}}Adapter created and active.{{/if}}
            {{#if (eq saved "created-draft")}}Adapter saved as a draft — complete the configuration to activate it.{{/if}}
            {{#if (eq saved "updated")}}Adapter updated.{{/if}}
            {{#if (eq saved "deleted")}}Adapter deleted.{{/if}}
            {{#if (eq saved "default-set")}}This adapter now fronts connected-app sign-in.{{/if}}
            {{#if (eq saved "default-cleared")}}Connected-app sign-in no longer uses an adapter.{{/if}}
          </p>
        </div>
      </div>
    {{/if}}

    {{#if errorMessage}}
      <div class="aeg-callout aeg-callout--danger">
        <span class="aeg-callout__icon" aria-hidden="true">⚠</span>
        <div class="aeg-callout__body">
          <p class="aeg-callout__title">Not saved</p>
          <p>{{errorMessage}}</p>
        </div>
      </div>
    {{/if}}

    {{#if testResult}}
      <div class="aeg-card">
        <div class="aeg-card__head">
          <h4>{{testResult.name}} — {{testResult.title}}</h4>
          <span class="pill {{#if testResult.ok}}pill--ok{{else}}pill--bad{{/if}}">{{#if testResult.ok}}Passed{{else}}Failed{{/if}}</span>
        </div>
        <div class="aeg-card__body">
          <p>{{testResult.detail}}</p>
        </div>
        {{#if testResult.claims}}
          <div class="aeg-table-wrap">
            <table class="aeg-table">
              <thead><tr><th>Claim</th><th>Value</th></tr></thead>
              <tbody>
                <tr><td>subject</td><td><code>{{testResult.claims.subject}}</code></td></tr>
                <tr><td>email</td><td>{{testResult.claims.email}}</td></tr>
                <tr><td>name</td><td>{{testResult.claims.name}}</td></tr>
                <tr><td>roles</td><td>{{#each testResult.claims.roles}}<span class="pill pill--mute">{{this}}</span> {{/each}}</td></tr>
                <tr><td>acr</td><td><code>{{testResult.claims.acr}}</code></td></tr>
              </tbody>
            </table>
          </div>
        {{/if}}
      </div>
    {{/if}}

    <div class="aeg-callout aeg-callout--info">
      <span class="aeg-callout__icon" aria-hidden="true">ⓘ</span>
      <div class="aeg-callout__body">
        <p class="aeg-callout__title">How this is enforced</p>
        <p>
          An adapter that does not validate is kept as a <em>draft</em> and
          cannot authenticate anyone (deny-by-default). The Kerberos and
          certificate adapters refuse to activate without a trusted-proxy
          allowlist, because a forwarded header is only as trustworthy as who
          may set it. Every create, update, delete and test is written to the
          evidence chain. Secrets are held by reference; signing certificates
          and trust anchors are public material and stored as-is.
        </p>
        {{#unless canSetSignInDefault}}
          <p>
            Designating an adapter as the deployment-wide sign-in default
            decides how everybody signs in, so it stays a platform action and is
            not offered here.
          </p>
        {{/unless}}
      </div>
    </div>

    <div class="aeg-section">
      <div class="aeg-section-head">
        <div>
          <h3>Configured adapters</h3>
          <p>{{#if instances.length}}{{instances.length}} configured{{else}}None configured yet{{/if}}</p>
        </div>
      </div>

      <div class="aeg-card">
        {{#if instances.length}}
          <div class="aeg-table-wrap">
            <table class="aeg-table">
              <thead>
                <tr>
                  <th>Name</th><th>Protocol</th><th>Status</th>
                  <th>Role in sign-in</th><th>Last test</th><th class="aeg-table__right">Actions</th>
                </tr>
              </thead>
              <tbody>
                {{#each instances}}
                  <tr>
                    <td>
                      <div class="aeg-table__name">{{name}}</div>
                      <div class="aeg-table__sub">{{catalog.summary}}</div>
                    </td>
                    <td>{{catalog.protocol}}</td>
                    <td>
                      <span class="pill {{#if isActive}}pill--ok{{else}}{{#if (eq status "draft")}}pill--warn{{else}}pill--bad{{/if}}{{/if}}">
                        <span class="pill__dot"></span>{{status}}
                      </span>
                    </td>
                    <td>
                      {{#if firstFactor}}<span class="pill pill--mute">First factor</span>{{/if}}
                      {{#if satisfiesSecond}}<span class="pill pill--mute">Completes sign-in</span>{{/if}}
                      {{#if defaultForSignIn}}<span class="pill pill--brand">Sign-in default</span>{{/if}}
                    </td>
                    <td>
                      {{#if lastTest}}
                        <span class="pill {{#if lastTest.ok}}pill--ok{{else}}pill--bad{{/if}}">{{lastTest.title}}</span>
                        <div class="aeg-table__sub">{{lastTest.at}}</div>
                      {{else}}
                        <span class="pill pill--mute">Not tested</span>
                      {{/if}}
                    </td>
                    <td class="aeg-table__right">
                      <details>
                        <summary class="aeg-btn aeg-btn--secondary aeg-btn--sm">Test &amp; manage</summary>
                        <div class="aeg-form" style="margin-top:12px;text-align:left">
                          <form action="{{../basePath}}/{{id}}/test" method="post">
                            <p class="field-hint">Run a self-test with sample input. Nothing is stored except pass/fail.</p>
                            {{#if (eq kind "saml")}}
                              <div class="aeg-field"><label class="aeg-field__label">Signed SAML Response (base64)</label><textarea class="aeg-textarea" name="samlResponse" rows="3" placeholder="PHNhbWxwOlJlc3BvbnNl…"></textarea></div>
                              <div class="aeg-field"><label class="aeg-field__label">…or IdP metadata XML</label><textarea class="aeg-textarea" name="metadataXml" rows="3" placeholder="&lt;EntityDescriptor…&gt;"></textarea></div>
                            {{/if}}
                            {{#if (eq kind "kerberos")}}
                              <div class="aeg-field"><label class="aeg-field__label">Sample principal</label><input class="aeg-input" name="principal" placeholder="jdoe@CLOUDSTRUCC.CA"></div>
                              <div class="aeg-field"><label class="aeg-field__label">Groups (optional)</label><input class="aeg-input" name="groups" placeholder="Domain Admins; Finance"></div>
                            {{/if}}
                            {{#if (eq kind "cba")}}
                              <div class="aeg-field"><label class="aeg-field__label">Client certificate (PEM)</label><textarea class="aeg-textarea" name="pem" rows="4" placeholder="-----BEGIN CERTIFICATE-----"></textarea></div>
                            {{/if}}
                            <div class="aeg-btns"><button class="aeg-btn aeg-btn--secondary" type="submit">Run test</button></div>
                          </form>

                          <form action="{{../basePath}}/{{id}}" method="post" style="margin-top:12px">
                            <input type="hidden" name="_action" value="update">
                            <label class="field-checkbox"><input type="checkbox" name="firstFactor" {{#if firstFactor}}checked{{/if}}><span>First factor</span></label>
                            <label class="field-checkbox"><input type="checkbox" name="satisfiesSecond" {{#if satisfiesSecond}}checked{{/if}}><span>Completes sign-in</span></label>
                            <input type="hidden" name="status" value="{{#if (eq status "disabled")}}active{{else}}disabled{{/if}}">
                            <div class="aeg-btns"><button class="aeg-btn aeg-btn--secondary aeg-btn--sm" type="submit">{{#if (eq status "disabled")}}Enable{{else}}Disable{{/if}}</button></div>
                          </form>

                          {{#if ../canSetSignInDefault}}
                            {{#if isActive}}
                              <form action="{{../basePath}}/{{id}}" method="post" style="margin-top:8px">
                                <input type="hidden" name="_action" value="{{#if defaultForSignIn}}clear-default{{else}}set-default{{/if}}">
                                <div class="aeg-btns"><button class="aeg-btn aeg-btn--secondary aeg-btn--sm" type="submit">{{#if defaultForSignIn}}Stop fronting sign-in{{else}}Use for connected-app sign-in{{/if}}</button></div>
                              </form>
                            {{/if}}
                          {{/if}}

                          <form action="{{../basePath}}/{{id}}" method="post" style="margin-top:8px" onsubmit="return confirm('Delete this adapter? Evidence of the change is kept.');">
                            <input type="hidden" name="_action" value="delete">
                            <div class="aeg-btns"><button class="aeg-btn aeg-btn--danger aeg-btn--sm" type="submit">Delete adapter</button></div>
                          </form>
                        </div>
                      </details>
                    </td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        {{else}}
          <div class="aeg-empty">
            <h4>No adapters configured yet</h4>
            <p>Pick a protocol below. Required fields must validate before an adapter goes active.</p>
          </div>
        {{/if}}
      </div>
    </div>

    <div class="aeg-section">
      <div class="aeg-section-head">
        <div>
          <h3>Add an adapter</h3>
          <p>Required fields must validate before the adapter goes active.</p>
        </div>
      </div>

      {{#each catalog}}
        <details class="aeg-card" style="margin-bottom:12px">
          <summary class="aeg-card__head">
            <h4>{{name}} {{#if mandatory}}<span class="pill pill--mute">SSC M4</span>{{/if}}</h4>
            <p>{{summary}}</p>
          </summary>
          <form action="{{../basePath}}" method="post">
            <div class="aeg-card__body">
              <div class="aeg-form">
                <input type="hidden" name="kind" value="{{kind}}">
                <div class="aeg-field">
                  <label class="aeg-field__label">Adapter name</label>
                  <input class="aeg-input" name="name" placeholder="{{name}} for {{#if ../tenant}}{{../tenant.organization}}{{else}}this deployment{{/if}}">
                </div>
                {{#each schema}}
                  <div class="aeg-field">
                    <label class="aeg-field__label">{{label}}{{#if required}} <span class="aeg-field__req">*</span>{{/if}}</label>
                    {{#if (eq type "textarea")}}
                      <textarea class="aeg-textarea" name="{{key}}" rows="3"></textarea>
                    {{else}}
                      {{#if (eq type "select")}}
                        <select class="aeg-select" name="{{key}}">
                          {{#each options}}<option value="{{this.[0]}}">{{this.[1]}}</option>{{/each}}
                        </select>
                      {{else}}
                        {{#if (eq type "boolean")}}
                          <label class="field-checkbox"><input type="checkbox" name="{{key}}" value="true" checked><span>Enabled</span></label>
                        {{else}}
                          <input class="aeg-input" name="{{key}}" type="{{#if (eq type "url")}}url{{else}}text{{/if}}">
                        {{/if}}
                      {{/if}}
                    {{/if}}
                    {{#if help}}<p class="field-hint">{{help}}</p>{{/if}}
                  </div>
                {{/each}}
              </div>
            </div>
            <div class="aeg-card__foot">
              <div class="aeg-btns"><button class="aeg-btn aeg-btn--primary" type="submit">Create {{name}} adapter</button></div>
            </div>
          </form>
        </details>
      {{/each}}
    </div>

    <div class="aeg-btns">
      <a class="aeg-btn aeg-btn--ghost" href="{{#if backHref}}{{backHref}}{{else}}/admin{{/if}}">{{#if backLabel}}{{backLabel}}{{else}}All settings{{/if}}</a>
    </div>
  </div>
</section>
