<section class="page-hero page-hero--compact">
  <p class="eyebrow">Account recovery</p>
  <h1>Choose a new password.</h1>
  <p>Signing in again afterwards will end every other session on your account.</p>
</section>

<section class="band band--white">
  <div class="auth-grid auth-grid--compact">
    {{#if valid}}
      <div class="section-heading">
        <p class="eyebrow">Step 2 of 2</p>
        <h2>Set your password.</h2>
        <p>Use at least 10 characters. A passphrase is easier to remember and harder to guess.</p>
      </div>

      <form class="subscribe-form" action="/auth/reset/{{token}}" method="post" novalidate>
        {{#if errorMessage}}<p class="form-alert">{{errorMessage}}</p>{{/if}}
        <div class="field-group">
          <label for="password">New password</label>
          <input id="password" name="password" type="password" autocomplete="new-password" minlength="10" required>
        </div>
        <div class="field-group">
          <label for="confirmPassword">Confirm new password</label>
          <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="10" required>
        </div>
        <button class="button button--primary" type="submit">Change password</button>
      </form>
    {{else}}
      <div class="section-heading">
        <h2>This link is no longer valid.</h2>
        <p>
          Reset links expire and can only be used once. Request a new one to
          continue.
        </p>
        <p class="form-footnote"><a href="/auth/forgot">Request a new link</a></p>
      </div>
    {{/if}}
  </div>
</section>
