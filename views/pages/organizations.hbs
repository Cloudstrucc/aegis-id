<section class="page-hero page-hero--compact">
  <p class="eyebrow">Organization Access</p>
  <h1>Choose your Aegis ID workspace.</h1>
  <p>{{#if welcome}}Subscription captured. Register your organization, or open an existing workspace you administer or contribute to.{{else}}Select the organization you want to configure for verified identity and wallet challenge flows.{{/if}}</p>
</section>

<section class="band band--white">
  <div class="section-heading">
    <p class="eyebrow">Signed in as {{subscription.email}}</p>
    <h2>Organizations</h2>
    <p>Aegis ID workspaces are scoped by organization so administrators and contributors can manage the right Verified ID, OIDC, SAML, and wallet challenge configuration.</p>
  </div>

  {{#if hasOrganizations}}
    <div class="organization-grid">
      {{#each organizations}}
        <article class="organization-tile {{#if isDisabled}}organization-tile--disabled{{/if}}">
          <div class="organization-tile__mark" style="--org-primary: {{brandPrimaryColor}}; --org-accent: {{brandAccentColor}};" aria-hidden="true">
            {{#if brandLogoDataUrl}}
              <img src="{{brandLogoDataUrl}}" alt="">
            {{else}}
              {{brandInitial}}
            {{/if}}
          </div>
          <div class="organization-tile__body">
            <span class="track-label">{{roleLabel}} / {{statusLabel}}</span>
            <h3>{{organization}}</h3>
            <p>{{#if updatedAt}}Updated {{updatedAt}}{{else}}Ready to configure{{/if}}</p>
          </div>
          <div class="organization-tile__actions">
            <a class="button button--blue" href="{{openPath}}">{{#if requiresWalletSetup}}Set up wallet{{else}}Open{{/if}}</a>
            <a class="button button--ghost" href="/organizations/{{subscriptionId}}/{{id}}/domain">
              {{#if identity.isVerified}}✓ {{identity.domain}}{{else}}Verify domain{{/if}}
            </a>
            <a class="button button--ghost" href="/organizations/{{subscriptionId}}/{{id}}/root-wallets">Root wallets</a>
            {{#if canManageWorkspace}}
              {{#if isDisabled}}
                <form action="/organizations/{{subscriptionId}}/{{id}}/enable" method="post">
                  <button class="button button--ghost" type="submit">Enable</button>
                </form>
              {{else}}
                <form action="/organizations/{{subscriptionId}}/{{id}}/disable" method="post">
                  <button class="button button--ghost" type="submit">Disable</button>
                </form>
              {{/if}}
              <form action="/organizations/{{subscriptionId}}/{{id}}/delete" method="post" data-confirm-message="Delete this organization workspace from your list? Audit history is retained.">
                <button class="button button--ghost" type="submit">Delete</button>
              </form>
            {{/if}}
          </div>
        </article>
      {{/each}}
    </div>
  {{else}}
    <article class="empty-state-panel">
      <span class="platform-icon">ID</span>
      <h2>Register your organization to continue.</h2>
      <p>No Aegis ID organization workspaces are associated with this subscriber yet. Create one, then you can open the dashboard and start the setup wizards.</p>
    </article>
  {{/if}}

  {{#unless showRegisterForm}}
    <div class="inline-actions">
      {{#if canAddWorkspace}}
        <a class="button button--primary button--blue" href="/organizations/{{subscription.id}}?add=1">Add organization</a>
        <span class="table-note">
          {{#if workspaceLimit}}
            Using {{workspacesUsed}} of {{workspaceLimit}} on {{planLabel}}.
          {{else}}
            {{planLabel}} includes unlimited organizations.
          {{/if}}
        </span>
      {{else}}
        <a class="button button--ghost" href="/plans">Upgrade to add another</a>
        <span class="table-note">
          {{planLabel}} includes {{workspaceLimit}} organization{{#unless (eq workspaceLimit 1)}}s{{/unless}},
          and you are using {{workspacesUsed}}.
        </span>
      {{/if}}
    </div>
  {{/unless}}
</section>

{{#if showRegisterForm}}
  <section class="band band--light">
    <div class="section-heading">
      <p class="eyebrow">Add an organization</p>
      <h2>Create another workspace.</h2>
      <p>Each organization is a separate workspace with its own credentials, roles, claims and branding. Whoever registers one is recorded as its first administrator; co-administrators can be added later through dual wallet challenges.</p>
    </div>

    <form class="subscribe-form subscribe-form--narrow" action="/organizations/{{subscription.id}}" method="post">
      <div class="field-group">
        <label for="organization">Organization name</label>
        <input id="organization" name="organization" type="text" value="{{formValues.organization}}" autocomplete="organization" placeholder="e.g. Contoso Legal" required>
        <p class="table-note">A new name creates a new workspace. Entering the name of one you already have simply reopens it.</p>
      </div>
      <input type="hidden" name="role" value="administrator">
      <div class="note-panel">
        <strong>Your role here</strong>
        <span>Administrator. Whoever registers an organization administers it.</span>
      </div>
      <div class="inline-actions">
        <button class="button button--primary button--blue" type="submit">Register organization</button>
        {{#if hasOrganizations}}
          <a class="button button--ghost" href="/organizations/{{subscription.id}}">Cancel</a>
        {{/if}}
      </div>
    </form>
  </section>
{{/if}}
