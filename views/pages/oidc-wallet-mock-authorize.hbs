<section class="page-hero page-hero--compact">
  <p class="eyebrow">Mock OIDC provider</p>
  <h1>Vanguard identity login.</h1>
  <p>This local provider returns a mock authorization code for the wallet-gated example app.</p>
</section>

<section class="band band--white">
  <div class="demo-app-shell demo-app-shell--narrow">
    <div class="demo-app-head">
      <div>
        <p class="eyebrow">Authorization request</p>
        <h2>Approve sign-in</h2>
      </div>
      <span class="demo-pill">OIDC</span>
    </div>

    <dl class="claim-list">
      <div>
        <dt>Client</dt>
        <dd>{{clientId}}</dd>
      </div>
      <div>
        <dt>Scope</dt>
        <dd>{{scope}}</dd>
      </div>
      <div>
        <dt>Nonce</dt>
        <dd>{{nonce}}</dd>
      </div>
      <div>
        <dt>Redirect URI</dt>
        <dd>{{redirectUri}}</dd>
      </div>
    </dl>

    <form action="/demo/oidc-wallet/mock-authorize" method="post">
      <input type="hidden" name="state" value="{{state}}">
      <input type="hidden" name="redirectUri" value="{{redirectUri}}">

      {{#if hasHolders}}
        <div class="field-group">
          <label class="field-label" for="holderChoice">Sign in as</label>
          <select id="holderChoice" name="holderChoice">
            {{#each holders}}
              <option value="{{email}}">
                {{displayName}} &middot; {{email}} &middot; {{organizationName}}{{#unless walletId}} (no Wallet ID){{/unless}}
              </option>
            {{/each}}
          </select>
          <p class="field-hint">Credential holders in your connected organizations. Pick the person whose wallet should receive the challenge.</p>
        </div>
      {{/if}}

      <div class="field-group">
        <label class="field-label" for="email">{{#if hasHolders}}Or another address{{else}}Sign in as{{/if}}</label>
        <input id="email" name="email" type="email" value="{{#unless hasHolders}}{{defaultEmail}}{{/unless}}"
               placeholder="you@example.com" autocomplete="off">
        <p class="field-hint">{{#if hasHolders}}Leave blank to use the holder selected above. Fill it in to sign in as someone not listed.{{else}}The email registered on the wallet that should receive the challenge.{{/if}}</p>
      </div>

      <div class="field-group">
        <label class="field-label" for="name">Display name</label>
        <input id="name" name="name" type="text" value="{{defaultName}}" placeholder="Your name">
      </div>

      <div class="wizard-actions">
        <button class="button button--primary button--blue" type="submit">Approve OIDC Login</button>
        <a class="button button--ghost" href="/demo/oidc-wallet">Cancel</a>
      </div>
    </form>
  </div>
</section>
