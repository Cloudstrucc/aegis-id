<section class="band band--white">
  <div class="section-heading">
    <p class="eyebrow">Platform settings</p>
    <h1>Notification delivery</h1>
    <p>Aegis ID sends sign-in codes, password reset links and wallet recovery codes. Configure at least one channel before going to production — without one, sign-in and recovery cannot complete.</p>
  </div>

  {{#if saved}}
    <div class="callout callout--success">
      <strong>Settings saved.</strong>
      {{#if testResult}}
        {{#if (eq testResult "ok")}}
          <span>SMTP connection verified successfully.</span>
        {{else}}
          <span>SMTP test failed: {{testResult}}</span>
        {{/if}}
      {{/if}}
    </div>
  {{/if}}

  <article class="blade-guidance">
    <strong>Why this matters</strong>
    <span>Codes and links are never returned in an API response — they only ever reach the person over a configured channel. If nothing is configured, the platform fails closed rather than exposing them. For local development choose the <em>Local file</em> provider, which writes messages to disk instead of sending them.</span>
  </article>

  <form class="wizard-form" action="/admin/notifications" method="post">

    <h2>Email (SMTP)</h2>
    <div class="field-group">
      <label class="field-checkbox">
        <input type="checkbox" name="emailEnabled" value="true" {{#if notificationSettings.email.enabled}}checked{{/if}}>
        Send verification codes by email
      </label>
    </div>

    <div class="field-row">
      <div class="field-group">
        <label class="field-label" for="emailPreset">Provider</label>
        <select id="emailPreset" name="emailPreset">
          {{#each notificationSettings.emailPresets}}
            <option value="{{id}}" {{#if (eq id ../notificationSettings.email.preset)}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
        <p class="field-hint">Microsoft 365 / Exchange Online and Gmail / Google Workspace are preconfigured. Choose Custom for an on-premises relay.</p>
      </div>
      <div class="field-group">
        <label class="field-label" for="emailFromAddress">From address</label>
        <input id="emailFromAddress" name="emailFromAddress" type="email" value="{{notificationSettings.email.fromAddress}}" placeholder="no-reply@vanguardcs.ca">
      </div>
    </div>

    <div class="field-row">
      <div class="field-group">
        <label class="field-label" for="emailHost">SMTP host <span class="field-tooltip" tabindex="0" data-tooltip="Only used when the provider is Custom. Presets supply their own host.">?</span></label>
        <input id="emailHost" name="emailHost" type="text" value="{{notificationSettings.email.host}}" placeholder="smtp.office365.com">
      </div>
      <div class="field-group">
        <label class="field-label" for="emailPort">Port</label>
        <input id="emailPort" name="emailPort" type="number" value="{{notificationSettings.email.port}}" placeholder="587">
        <p class="field-hint">587 with STARTTLS is correct for Exchange Online and Gmail. Use 465 with implicit TLS below.</p>
      </div>
    </div>

    <div class="field-group">
      <label class="field-checkbox">
        <input type="checkbox" name="emailSecure" value="true" {{#if notificationSettings.email.secure}}checked{{/if}}>
        Use implicit TLS (port 465)
      </label>
    </div>

    <div class="field-row">
      <div class="field-group">
        <label class="field-label" for="emailUsername">Username</label>
        <input id="emailUsername" name="emailUsername" type="text" value="{{notificationSettings.email.username}}" autocomplete="off">
      </div>
      <div class="field-group">
        <label class="field-label" for="emailPassword">Password / app password</label>
        <input id="emailPassword" name="emailPassword" type="password" autocomplete="new-password"
               placeholder="{{#if notificationSettings.email.hasPassword}}•••••••• (unchanged){{else}}Enter password{{/if}}">
        <p class="field-hint">Gmail requires an App Password. Microsoft 365 needs SMTP AUTH enabled, or an app password when MFA is on. Leave blank to keep the stored value.</p>
      </div>
    </div>

    <div class="field-group">
      <label class="field-label" for="emailFromName">From name</label>
      <input id="emailFromName" name="emailFromName" type="text" value="{{notificationSettings.email.fromName}}">
    </div>

    <h2>SMS</h2>
    <div class="field-group">
      <label class="field-checkbox">
        <input type="checkbox" name="smsEnabled" value="true" {{#if notificationSettings.sms.enabled}}checked{{/if}}>
        Send verification codes by SMS
      </label>
      <p class="field-hint">Only wallets with a mobile number on file can receive SMS codes.</p>
    </div>

    <div class="field-row">
      <div class="field-group">
        <label class="field-label" for="smsPreset">Provider</label>
        <select id="smsPreset" name="smsPreset">
          {{#each notificationSettings.smsPresets}}
            <option value="{{id}}" {{#if (eq id ../notificationSettings.sms.preset)}}selected{{/if}}>{{label}}</option>
          {{/each}}
        </select>
      </div>
      <div class="field-group">
        <label class="field-label" for="smsFromNumber">From number</label>
        <input id="smsFromNumber" name="smsFromNumber" type="tel" value="{{notificationSettings.sms.fromNumber}}" placeholder="+16135550100">
      </div>
    </div>

    <div class="field-group">
      <label class="field-label" for="smsEndpoint">API endpoint</label>
      <input id="smsEndpoint" name="smsEndpoint" type="url" value="{{notificationSettings.sms.endpoint}}"
             placeholder="https://api.twilio.com/2010-04-01/Accounts/{accountSid}/Messages.json">
      <p class="field-hint">Any provider accepting a JSON POST works. <code>{accountSid}</code> is substituted automatically.</p>
    </div>

    <div class="field-row">
      <div class="field-group">
        <label class="field-label" for="smsAccountSid">Account SID / key</label>
        <input id="smsAccountSid" name="smsAccountSid" type="text" value="{{notificationSettings.sms.accountSid}}" autocomplete="off">
      </div>
      <div class="field-group">
        <label class="field-label" for="smsAuthToken">Auth token</label>
        <input id="smsAuthToken" name="smsAuthToken" type="password" autocomplete="new-password"
               placeholder="{{#if notificationSettings.sms.hasAuthToken}}•••••••• (unchanged){{else}}Enter token{{/if}}">
      </div>
    </div>

    <h2>What gets sent where</h2>
    <p class="field-hint">Each kind of message can use email, SMS, or both. A message with no channel ticked is never sent.</p>
    <table class="data-table">
      <thead>
        <tr><th>Message</th><th>Email</th><th>SMS</th></tr>
      </thead>
      <tbody>
        {{#each notificationSettings.messageTypeCatalog}}
          <tr>
            <td>
              <strong>{{this.label}}</strong>
              <div class="table-note">{{this.description}}</div>
            </td>
            <td>
              <input type="checkbox" name="type_{{this.id}}_email" value="true" {{#if this.email}}checked{{/if}}
                     aria-label="Send {{this.label}} by email">
            </td>
            <td>
              <input type="checkbox" name="type_{{this.id}}_sms" value="true" {{#if this.sms}}checked{{/if}}
                     aria-label="Send {{this.label}} by SMS">
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>

    <div class="modal-actions">
      <button class="button button--primary" type="submit" name="action" value="save">Save settings</button>
      <button class="button" type="submit" name="action" value="test">Save and test SMTP</button>
    </div>
  </form>

  {{#if deliveryLog.length}}
    <h2>Recent deliveries</h2>
    <p class="field-hint">Recipients are masked. Message contents are never stored.</p>
    <table class="data-table">
      <thead>
        <tr><th>When</th><th>Message</th><th>To</th><th>Result</th></tr>
      </thead>
      <tbody>
        {{#each deliveryLog}}
          <tr>
            <td>{{this.at}}</td>
            <td>{{this.type}}</td>
            <td>{{this.recipient}}</td>
            <td>
              {{#if this.delivered}}
                Sent via {{#each this.channels}}{{this}} {{/each}}
              {{else}}
                Not sent{{#if this.failures.length}} — {{#each this.failures}}{{this}} {{/each}}{{/if}}
              {{/if}}
            </td>
          </tr>
        {{/each}}
      </tbody>
    </table>
  {{/if}}

  {{#if notificationSettings.updatedAt}}
    <p class="muted">Last updated {{notificationSettings.updatedAt}}{{#if notificationSettings.updatedBy}} by {{notificationSettings.updatedBy}}{{/if}}.</p>
  {{/if}}
</section>
