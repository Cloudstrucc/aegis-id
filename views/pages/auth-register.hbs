<section class="page-hero page-hero--compact">
  <p class="eyebrow">Subscriber access</p>
  <h1>Create your Aegis ID account.</h1>
  <p>Register first, complete second-factor verification, then open organizations you belong to or subscribe your own organization.</p>
</section>

<section class="band band--white">
  <div class="auth-grid">
    <div class="section-heading">
      <p class="eyebrow">Secure signup</p>
      <h2>Start with a verified user account.</h2>
      <p>Vanguard Cloud Services uses Passport.js sessions with a second factor before organization access, subscription, and administration are available.</p>
    </div>

    {{#if chosenPlan.wasChosen}}
      <article class="chosen-plan">
        <p class="eyebrow">Your plan</p>
        <h3>{{chosenPlan.label}} — {{chosenPlan.price}}</h3>
        {{#if chosenPlan.isSettled}}
          <p>Covered by a registration code. You will not be charged.</p>
        {{else if chosenPlan.requiresPayment}}
          <p>Payment is not set up yet, so trial limits apply until it is.</p>
        {{else}}
          <p>30 days, no card required.</p>
        {{/if}}
        <p class="table-note"><a href="/plans">Change plan</a></p>
      </article>
    {{else}}
      <p class="form-footnote">Not sure which plan you need? <a href="/plans">Compare plans</a>.</p>
    {{/if}}

    <form class="subscribe-form" action="/auth/register" method="post" novalidate>
      {{#if errorMessage}}<p class="form-alert">{{errorMessage}}</p>{{/if}}

      <div class="field-row">
        <div class="field-group">
          <label for="displayName">Full name</label>
          <input id="displayName" name="displayName" type="text" value="{{formValues.displayName}}" autocomplete="name" required>
          {{#if formErrors.displayName}}<p class="field-error">{{formErrors.displayName}}</p>{{/if}}
        </div>
        <div class="field-group">
          <label for="email">Work email</label>
          <input id="email" name="email" type="email" value="{{formValues.email}}" autocomplete="email" required>
          {{#if formErrors.email}}<p class="field-error">{{formErrors.email}}</p>{{/if}}
        </div>
      </div>

      <div class="field-row">
        <div class="field-group">
          <label for="password">Password</label>
          <input id="password" name="password" type="password" autocomplete="new-password" required>
          {{#if formErrors.password}}<p class="field-error">{{formErrors.password}}</p>{{/if}}
        </div>
        <div class="field-group">
          <label for="confirmPassword">Confirm password</label>
          <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" required>
          {{#if formErrors.confirmPassword}}<p class="field-error">{{formErrors.confirmPassword}}</p>{{/if}}
        </div>
      </div>

      <div class="field-row">
        <div class="field-group">
          <label for="phone">Mobile phone</label>
          <input id="phone" name="phone" type="tel" value="{{formValues.phone}}" autocomplete="tel">
          {{#if formErrors.phone}}<p class="field-error">{{formErrors.phone}}</p>{{/if}}
        </div>
        <div class="field-group">
          <label for="preferredMfa">Second factor</label>
          <select id="preferredMfa" name="preferredMfa">
            <option value="email" {{#if (eq formValues.preferredMfa "email")}}selected{{/if}}>Email code</option>
            <option value="sms" {{#if (eq formValues.preferredMfa "sms")}}selected{{/if}}>SMS code</option>
            <option value="passkey" {{#if (eq formValues.preferredMfa "passkey")}}selected{{/if}}>Passkey</option>
          </select>
        </div>
      </div>

      <div class="field-group">
        <label for="organization">Organization to subscribe (optional)</label>
        <input id="organization" name="organization" type="text" value="{{formValues.organization}}" autocomplete="organization">
      </div>

      <div class="field-group">
        <label for="interest">Identity track</label>
        <select id="interest" name="interest">
          <option value="both" {{#if (eq formValues.interest "both")}}selected{{/if}}>Both tracks</option>
          <option value="microsoft-native" {{#if (eq formValues.interest "microsoft-native")}}selected{{/if}}>Verified credential integrations</option>
          <option value="aries-lab" {{#if (eq formValues.interest "aries-lab")}}selected{{/if}}>Aries lab</option>
        </select>
      </div>

      <button class="button button--primary" type="submit">Create account</button>

      {{#if passwordlessEnrolmentEnabled}}
        <div class="enrol-passwordless">
          <p class="auth-divider">or</p>
          <p class="enrol-passwordless__lead">Prefer no password? Fill in your name and email above, then enrol with a security key or passkey instead — the other fields are not needed.</p>
          <button class="button button--ghost" type="button" data-passkey-enrol>
            <svg class="auth-panel__icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
                 stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="11" width="18" height="10" rx="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
            Create account with a passkey
          </button>
          <p class="form-footnote" data-passkey-status aria-live="polite"></p>
        </div>
      {{/if}}
      <p class="form-footnote">Already registered? <a href="/auth/login">Sign in</a>.</p>
    </form>
  </div>
</section>
