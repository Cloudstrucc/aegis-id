<!doctype html>
<html lang="{{#if locale}}{{locale}}{{else}}en{{/if}}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="description" content="{{description}}">
    <title>{{#if (eq title appName)}}{{appName}}{{else}}{{title}} | {{appName}}{{/if}}</title>
    {{!-- An organization's own favicon wins; otherwise the Aegis shield. The
          browser asked for /favicon.ico on every page and got the 404 page. --}}
    {{#if site.branding.faviconUrl}}
      <link rel="icon" href="{{site.branding.faviconUrl}}">
    {{else}}
      <link rel="icon" href="/favicon.ico" sizes="any">
      <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32">
      <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    {{/if}}
    {{!-- Before the stylesheets and without defer, so the stored theme is on
          the root element before anything paints. An inline script here would
          be blocked: the CSP is script-src 'self' with no 'unsafe-inline'. --}}
    <script src="/scripts/theme-boot.js?v={{assetVersion}}"></script>
    {{!-- Self-hosted: the CSP allows styles and fonts from 'self' only. --}}
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="/fonts/saira-latin.woff2" as="font" type="font/woff2" crossorigin>
    <link rel="stylesheet" href="/styles/fonts.css?v={{assetVersion}}">
    <link rel="stylesheet" href="/styles/main.css?v={{assetVersion}}">
    {{!-- Appended last on purpose: it redefines the three legacy token
          families from the official palette and adds dark mode. --}}
    <link rel="stylesheet" href="/styles/brand-layer.css?v={{assetVersion}}">
  </head>
  <body{{#if bodyClass}} class="{{bodyClass}}"{{/if}}>
    {{> site-header}}
    {{!--
      Two body shapes. An application page gets the sidebar shell; everything
      else — anonymous pages, the sign-in and recovery flows, checkout, the
      rendered documents — gets the plain single column it had.

      `data-workspace-blade` goes on the shell rather than inside the page,
      because the blade links now live in the sidebar: the script looks for
      links and panels within one shell element, and they are on opposite
      sides of it.
    --}}
    {{#if appShell}}
      <div class="app-shell"{{#if appShell.hasBlades}} data-workspace-blade{{/if}}>
        {{> app-sidebar}}
        <div class="app-shell__body">
          {{> app-topbar}}
          <main class="app-shell__main">
            {{{body}}}
          </main>
        </div>
      </div>
    {{else}}
      <main>
        {{{body}}}
      </main>
    {{/if}}
    {{> site-footer}}
    {{> flash}}
    {{> cookie-notice}}
    {{#each pageScripts}}
      <script src="{{src}}" defer></script>
    {{/each}}
    <script src="/scripts/main.js?v={{assetVersion}}" defer></script>
  </body>
</html>
