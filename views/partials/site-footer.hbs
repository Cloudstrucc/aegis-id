<footer class="site-footer">
  <div>
    {{#if site.branding.logoUrl}}
      <img class="footer-logo" src="{{site.branding.logoUrl}}" alt="{{site.branding.logoAlt}}">
    {{else}}
      <strong class="footer-wordmark">{{site.branding.displayName}}</strong>
    {{/if}}
    {{#unless site.branding.isPlatform}}<strong>{{site.branding.shortName}}</strong>{{/unless}}
    <span>Portable identity assurance, wallet challenges, and interoperability testing in one governed platform.</span>
  </div>
  <span>
    <a href="{{#if site.branding.supportEmail}}{{#unless site.branding.isPlatform}}mailto:{{site.branding.supportEmail}}{{else}}/support{{/unless}}{{else}}/support{{/if}}">Support</a>
    &middot;
    <a href="/privacy">Privacy</a>
    &middot;
    &copy; {{year}} {{site.branding.displayName}}
    {{#unless site.branding.poweredByHidden}}
      &middot;
      <span class="footer-powered-by">Powered by Aegis ID</span>
    {{/unless}}
  </span>
</footer>
