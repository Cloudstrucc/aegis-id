# Release signing for scripts/release-android.sh.
#
# Copy this file to .env.android (untracked) and fill in your own values:
#     cp .env.android.example .env.android
#
# Unlike iOS, these are one keystore for every environment: dev, qa and prod
# differ only by applicationId suffix, so one signing key covers all three.

# Absolute path to the release keystore. Keep it OUTSIDE the repository.
#
# A lost release keystore cannot be replaced. Without it the app can never be
# updated on Play under the same package name — you would need a new listing.
# Back it up somewhere durable, not just ~/Downloads.
AEGIS_KEYSTORE_PATH=

# Password for the keystore itself.
AEGIS_KEYSTORE_PASSWORD=

# The key alias inside the keystore. List them with:
#     keytool -list -v -keystore /path/to/key.jks
AEGIS_KEY_ALIAS=

# Password for that key. Leave blank if it is the same as the keystore password.
AEGIS_KEY_PASSWORD=
