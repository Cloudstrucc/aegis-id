<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/vanguard_icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/vanguard_icon"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="invite"
                    android:scheme="${aegisUrlScheme}" />
                <data
                    android:host="credential-invite"
                    android:scheme="${aegisUrlScheme}" />
                <!-- Product-path organization invitations, which do not go
                     through ACA-Py. Without this the deep link never reaches
                     the app. -->
                <data
                    android:host="org-invite"
                    android:scheme="${aegisUrlScheme}" />
                <data
                    android:host="wallet"
                    android:scheme="${aegisUrlScheme}" />
                <!-- Root wallet nomination and break-glass authorisation. Both
                     are scanned from the organization's root wallets page, and
                     without these the QR opens nothing. -->
                <data
                    android:host="root-wallet-confirm"
                    android:scheme="${aegisUrlScheme}" />
                <data
                    android:host="break-glass-authorise"
                    android:scheme="${aegisUrlScheme}" />
                <!-- A root wallet approving an administrator's recovery. The
                     link is sent to this holder, not to the person recovering. -->
                <data
                    android:host="recovery-approve"
                    android:scheme="${aegisUrlScheme}" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="openid-vc" />
            </intent-filter>

            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="${aegisAppLinkHost}"
                    android:pathPrefix="/wallet"
                    android:scheme="https" />
            </intent-filter>
        </activity>

        <!-- The wallet as a FIDO2 passkey provider.
             API 34+ only: CredentialProviderService did not exist before, and
             the manifest entry is guarded so older devices install the app and
             simply do not offer it.

             Disabled in 1.0 via passkeyProviderEnabled in build.gradle.kts. A
             disabled service is not listed by Android, so the wallet does not
             appear as a passkey provider at all — which is the point, because
             the assertion path does not yet work. -->
        <service
            android:name=".passkey.AegisCredentialProviderService"
            android:enabled="${passkeyProviderEnabled}"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_CREDENTIAL_PROVIDER_SERVICE">
            <intent-filter>
                <action android:name="android.service.credentials.CredentialProviderService" />
            </intent-filter>
            <meta-data
                android:name="android.credentials.provider"
                android:resource="@xml/credential_provider" />
        </service>

        <!-- Where the holder agrees. The service cannot show anything, so every
             create and every assertion is routed here through a PendingIntent. -->
        <activity
            android:name=".passkey.PasskeyConsentActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:theme="@style/PasskeyConsentTheme" />
    </application>
</manifest>
