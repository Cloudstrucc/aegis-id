<?xml version="1.0" encoding="utf-8"?>
<!-- What this provider can hold. Passkeys only: the wallet has no business
     storing passwords, and offering to would put it in front of the holder for
     requests it should not be answering. -->
<credential-provider
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:settingsSubtitle="@string/passkey_provider_subtitle">
    <capabilities>
        <capability name="androidx.credentials.TYPE_PUBLIC_KEY_CREDENTIAL" />
    </capabilities>
</credential-provider>
